# BİŞIŞ V1 — production/staging environment example contract
NODE_ENV=production
PORT=5000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
ALLOWED_ORIGINS=https://your-production-domain.example
TRUST_PROXY_HOPS=1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
VITE_API_URL=https://your-production-api.example
VITE_ENABLE_GOOGLE_OAUTH=false
VITE_GOOGLE_CLIENT_ID=
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET_KEY=your-nowpayments-ipn-secret
PUBLIC_API_URL=https://your-production-api.example
PUBLIC_WEB_URL=https://your-production-domain.example
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
GOOGLE_CLIENT_SECRET=your-google-client-secret
AI_PROVIDER=disabled
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_API_KEY=
LOG_LEVEL=info
FRONTEND_URL=https://your-production-domain.example

# AI OS Integration
# Keep disabled by default.
AI_OS_ENABLED=false

# Set only in an untracked runtime environment.
AI_OS_WEBHOOK_URL=

# Optional. Do not place real secrets in tracked files.
AI_OS_WEBHOOK_SECRET=

# Request timeout in milliseconds.
AI_OS_TIMEOUT_MS=10000

# Manual live-test scripts (backend/test-*.js, backend/verify_015.js, backend/tests/runtime-test.js)
# Local test-account credentials — configure in the untracked .env file only
BISIS_TEST_ADMIN_EMAIL=
BISIS_TEST_ADMIN_PASSWORD=
BISIS_TEST_CLIENT_EMAIL=
BISIS_TEST_CLIENT_PASSWORD=
TEST_USER_PASSWORD=

# API documentation (Swagger UI at /api-docs, OpenAPI JSON at /api-docs.json).
# Hidden in production unless explicitly set to "true".
SWAGGER_ENABLED=
